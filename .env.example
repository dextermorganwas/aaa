# Public URL used in the admin UI / diagnostics.
# Host directory used by docker-compose for persistent application data.
# If your server already defines this globally, keep using that value.
DOCKER_DATA_DIR=/mnt/docker

PUBLIC_BASE_URL=http://localhost:8099

# Provider credentials
TMDB_BEARER_TOKEN=
TVDB_API_KEY=
# Optional subscriber PIN for TVDB accounts that require one.
TVDB_USER_PIN=

# Server
HOST=0.0.0.0
PORT=8099
LOG_LEVEL=INFO
CPU_LIMIT=1.0
MEMORY_LIMIT=512m
PIDS_LIMIT=128

# Image sizes
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=original
TMDB_LOGO_SIZE=original

# Request behavior
HTTP_TIMEOUT_SECONDS=6
TPDB_TIMEOUT_SECONDS=4.0
TPDB_SEARCH_PAGES=2
TPDB_MAX_TARGETS=8
TPDB_MATCHER_VERSION=2
TPDB_BACKGROUND_REFRESH=true
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.35
MAX_CONCURRENT_PROVIDER_REQUESTS=8
MAX_IMAGE_BYTES=15000000

# Cache / persistence
DATA_DIR=/data
CACHE_TTL_SECONDS=2592000
TPDB_CACHE_TTL_SECONDS=0
FAILURE_COOLDOWN_SECONDS=300
NEGATIVE_CACHE_TTL_SECONDS=900

# Admin UI
ADMIN_ENABLED=true
ADMIN_TOKEN=change-me
